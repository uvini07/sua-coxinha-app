{
  "name": "pontos-dourados",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "App do clube de fidelidade da Sua Coxinha. Web, só mobile, instalável como PWA.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "testar:regras": "firebase emulators:exec --only firestore --project suacoxinhaapp \"node testes/regras.test.mjs\"",
    "app:sync": "npm run build && cap sync",
    "app:android": "npm run build && cap sync android && cap open android",
    "app:ios": "npm run build && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "firebase": "^13.0.0",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^14.0.0",
    "vite": "^8.3.0"
  },
  "overrides": {
    "@firebase/rules-unit-testing": {
      "firebase": "$firebase"
    },
    "@capacitor-firebase/authentication": {
      "firebase": "$firebase"
    }
  }
}
