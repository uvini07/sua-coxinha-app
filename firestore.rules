//            && request.resource.data.acumulado == resource.data.acumulado
//            && request.resource.data.resgates == resource.data.resgates
//            && request.resource.data.missoes == resource.data.missoes;
//      }
//
//      allow update: if meu() && pontosIntactos();
//
// E as subcoleções `historico` e `vouchers` passam a ser somente leitura para
// o cliente — quem escreve nelas é a função do servidor.
