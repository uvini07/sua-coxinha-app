{
  "appId": "br.com.suacoxinha.pontosdourados",
  "appName": "Pontos Dourados",
  "webDir": "dist",
  "backgroundColor": "#131313",
  "android": {
    "backgroundColor": "#131313",
    "allowMixedContent": false
  },
  "ios": {
    "backgroundColor": "#131313",
    "contentInset": "always"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#131313",
      "showSpinner": false
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": false,
      "providers": [
        "google.com",
        "apple.com"
      ]
    }
  }
}
